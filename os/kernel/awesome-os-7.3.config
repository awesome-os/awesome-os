# Awesome-OS Linux 7.3.6 — Zero-Pain Minimal + Modern Kernel Config Fragment
# Targets: Bare-Metal UEFI, Hyper-V Gen-2, Proxmox/KVM, QEMU, Apple Silicon (ARM64)
# Philosophy: Fast boot, io_uring + B8G_ARENA_V1 userspace, zero legacy ISA/X11 cruft.

# --- 1. Fast Reproducible Boot & Compression ---
CONFIG_KERNEL_ZSTD=y
CONFIG_RD_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_PREEMPT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# --- 2. Modern Zero-Copy I/O, eBPF & Userspace Micro-Services ---
CONFIG_IO_URING=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_USERFAULTFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- 3. Zero Black-Screen Boots (Dual Console + SimpleDRM + Hyper-V + VirtIO + NVMe) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# --- 4. First-Class Kernel Debugging (Zero Silent Panics) ---
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_GDB_SCRIPTS=y
CONFIG_PANIC_TIMEOUT=5

# --- 5. Purge Legacy Bloat ---
# CONFIG_BLK_DEV_FD is not set
# CONFIG_ISA is not set
# CONFIG_PCCARD is not set
# CONFIG_ISDN is not set
# CONFIG_SOUND_OSS_CORE is not set
# CONFIG_AGP is not set
