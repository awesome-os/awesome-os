# AwesomeOS Holo v11 Mozilla Build Configuration (`browser/firefox/mozconfig.holo-v11`)
# Target: Sovereign Firefox (Gecko / Stylo / WebRender / Fission / RLBox)
# Shared 24/24 Holo v11 CAS System Libraries + Zero Mozilla Telemetry / Updater / Crashreporter

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-holo-v11

# Application & Release Optimization
ac_add_options --enable-application=browser
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --enable-rust-simd
ac_add_options --enable-wayland
ac_add_options --disable-debug
ac_add_options --disable-tests

# Strip Mozilla Telemetry, Crashreporter, Updater, and Parental Controls
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-parental-controls
ac_add_options --disable-necko-wifi

export MOZ_TELEMETRY_REPORTING=
export MOZ_DATA_REPORTING=
export MOZ_SERVICES_HEALTHREPORT=
export MOZ_CRASHREPORTER=

# RLBox WASM Sandboxing for Third-Party C/C++ Parsers
ac_add_options --enable-rlbox-wasm-sandboxing

# Holo v11 Shared System Libraries (24/24 CAS Deduplication)
ac_add_options --with-system-icu
ac_add_options --with-system-zlib
ac_add_options --with-system-nspr
ac_add_options --with-system-nss
ac_add_options --with-system-libvpx
ac_add_options --with-system-webp
ac_add_options --with-system-jpeg
ac_add_options --with-system-png
ac_add_options --with-system-harfbuzz
ac_add_options --with-system-dav1d
ac_add_options --with-system-aom
ac_add_options --with-system-pixman
ac_add_options --with-system-cairo
ac_add_options --with-system-libevent
ac_add_options --with-system-ffi
ac_add_options --with-system-libopus
ac_add_options --enable-system-sqlite
