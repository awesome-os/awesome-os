#!/usr/bin/env node
/**
 * @file intersections/holo-compiler/generate-unified-pins.mts
 * @description Reads `holo-total-collapse-plan.json` and emits the 3 canonical Wave-1
 * unified dependency pin manifests into `github-mirror/awesome-os/holo-sdk/pins/`:
 *   - `holo-unified-rust-pins.toml`
 *   - `holo-unified-go.work` & `holo-unified-go-pins.mod`
 *   - `holo-unified-npm-overrides.json`
 *
 * Strictly `erasableSyntaxOnly: true`, Node 22+ built-ins only.
 */

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import type { TotalCollapsePlan } from './overlap-collapse-scanner.mts';

export function pickHighestCleanSemver(versions: readonly string[], fallback = 'latest'): string {
  const cleaned = versions
    .map((v) => v.trim().replace(/^[~^=<>]+/, '').replace(/^v/, ''))
    .filter((v) => /^\d+\.\d+\.\d+/.test(v));
  if (cleaned.length === 0) return versions[versions.length - 1] || fallback;
  cleaned.sort((a, b) => {
    const pa = a.split(/[.-]/).slice(0, 3).map(Number);
    const pb = b.split(/[.-]/).slice(0, 3).map(Number);
    for (let i = 0; i < 3; i++) {
      const diff = (pa[i] || 0) - (pb[i] || 0);
      if (diff !== 0) return diff;
    }
    return a.localeCompare(b);
  });
  return cleaned[cleaned.length - 1]!;
}

export function generateRustPinsToml(plan: TotalCollapsePlan, limit = 50): string {
  const rust = plan.topOverlaps.filter((o) => o.ecosystem === 'rust').slice(0, limit);
  const lines = [
    '# Auto-generated by intersections/holo-compiler/generate-unified-pins.mts',
    `# Source: holo-total-collapse-plan.json (${plan.reposScanned} repos, ${plan.byEcosystem.rust.overlappingDeps} overlapping Rust crates)`,
    '# ABI: B8G_ABI_MAGIC_V3 (0x33564742) | CAS: v11',
    '',
    '[workspace.dependencies]',
  ];
  for (const item of rust) {
    const pinned = pickHighestCleanSemver(item.distinctVersions);
    lines.push(
      `${item.name} = "${pinned}" # collapsed ${item.versionSkew} versions across ${item.repoCount} repos`,
    );
  }
  lines.push('');
  return lines.join('\n');
}

export function generateGoWorkAndPins(
  plan: TotalCollapsePlan,
  limit = 50,
): { readonly goWork: string; readonly goPinsMod: string } {
  const goWork = [
    '// Auto-generated by intersections/holo-compiler/generate-unified-pins.mts',
    '// Unified Go workspace collapsing the 5 GitLab Go repos + awesome-os/go-lang v11 CAS',
    'go 1.26.0',
    '',
    'use (',
    '\t../../go-lang/b8g-casv11',
    '\t../../gitaly',
    '\t../../gitlab-runner',
    '\t../../gitlab-shell',
    '\t../../gitlab-pages',
    '\t../../gitlab-foss/workhorse',
    ')',
    '',
  ].join('\n');

  const goDeps = plan.topOverlaps.filter((o) => o.ecosystem === 'go').slice(0, limit);
  const modLines = [
    '// Auto-generated canonical Go module version pins (Wave-1 Overlap Collapse)',
    'module github.com/awesome-os/holo-sdk/pins',
    '',
    'go 1.26.0',
    '',
    'require (',
  ];
  for (const item of goDeps) {
    const pinned = pickHighestCleanSemver(item.distinctVersions);
    const vTag = pinned.startsWith('v') ? pinned : `v${pinned}`;
    modLines.push(
      `\t${item.name} ${vTag} // collapsed ${item.versionSkew} versions across ${item.repoCount} repos`,
    );
  }
  modLines.push(')', '');

  return { goWork, goPinsMod: modLines.join('\n') };
}

const DEBLOAT_PURGE_PACKAGES = new Set([
  'eslint',
  'eslint-config-prettier',
  'prettier',
  'mocha',
  '@typescript-eslint/eslint-plugin',
  '@typescript-eslint/parser',
]);

export function generateNpmOverridesJson(plan: TotalCollapsePlan, limit = 50): Record<string, unknown> {
  const npmDeps = plan.topOverlaps.filter((o) => o.ecosystem === 'npm').slice(0, limit);
  const overrides: Record<string, string> = {
    // Canonical Awesome-OS Wave 2 TypeScript 6.0.3
    typescript: '6.0.3',
  };
  const debloatPurgeCandidates: Array<{ name: string; repoCount: number; distinctVersions: number }> = [];

  for (const item of npmDeps) {
    if (item.name === 'typescript') continue;
    if (DEBLOAT_PURGE_PACKAGES.has(item.name)) {
      debloatPurgeCandidates.push({
        name: item.name,
        repoCount: item.repoCount,
        distinctVersions: item.versionSkew,
      });
      continue;
    }
    overrides[item.name] = pickHighestCleanSemver(item.distinctVersions);
  }

  return {
    schema: 'awesome-os-holo-npm-overrides-v1',
    abiMagic: '0x33564742',
    casLayout: 'v11',
    sourceReposScanned: plan.reposScanned,
    pnpm: {
      overrides,
    },
    debloatPurgeCandidates,
  };
}

const isDirectEntry =
  process.argv[1] !== undefined &&
  path.resolve(process.argv[1]) === path.resolve(fileURLToPath(import.meta.url));

if (isDirectEntry) {
  const root = path.resolve(import.meta.dirname, '..', '..');
  const planPath = path.join(root, 'holo-total-collapse-plan.json');
  const pinsDir = path.join(root, 'github-mirror', 'awesome-os', 'holo-sdk', 'pins');

  const plan = JSON.parse(fs.readFileSync(planPath, 'utf8')) as TotalCollapsePlan;
  fs.mkdirSync(pinsDir, { recursive: true });

  const rustToml = generateRustPinsToml(plan, 50);
  const { goWork, goPinsMod } = generateGoWorkAndPins(plan, 50);
  const npmJson = generateNpmOverridesJson(plan, 50);

  fs.writeFileSync(path.join(pinsDir, 'holo-unified-rust-pins.toml'), rustToml, 'utf8');
  fs.writeFileSync(path.join(pinsDir, 'holo-unified-go.work'), goWork, 'utf8');
  fs.writeFileSync(path.join(pinsDir, 'holo-unified-go-pins.mod'), goPinsMod, 'utf8');
  fs.writeFileSync(
    path.join(pinsDir, 'holo-unified-npm-overrides.json'),
    JSON.stringify(npmJson, null, 2) + '\n',
    'utf8',
  );

  console.log(
    JSON.stringify(
      {
        pinsDir,
        rustPins: plan.topOverlaps.filter((o) => o.ecosystem === 'rust').slice(0, 50).length,
        goPins: plan.topOverlaps.filter((o) => o.ecosystem === 'go').slice(0, 50).length,
        npmOverrides: Object.keys((npmJson.pnpm as { overrides: Record<string, string> }).overrides).length,
        debloatPurgeCandidates: (npmJson.debloatPurgeCandidates as unknown[]).length,
      },
      null,
      2,
    ),
  );
}
